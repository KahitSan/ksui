{
  "name": "@kahitsan/ksui-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Live documentation site for @kahitsan/ksui. Self contained Vite + SolidJS SPA; not part of the published package and not in the root tsconfig.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/router": "2.0.1",
    "@solidjs/web": "2.0.4",
    "solid-js": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.61.0",
    "postcss": "^8.5.15",
    "shiki": "^1.24.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "3.0.0-next.27"
  }
}
