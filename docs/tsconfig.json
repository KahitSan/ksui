{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "node"],
    "paths": {
      "@kahitsan/ksui": ["../src/index.ts"],
      "@kahitsan/ksui/icons": ["../src/icons/index.ts"],
      "@kahitsan/ksui/icons/*": ["../src/icons/*"]
    }
  },
  "include": ["src", "vite.config.ts", "scripts"]
}
