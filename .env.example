# Database connection for `npm test` (integration tests) and local dev.
#
# This plugin is independent: it reads only THIS file's vars, never the kernel's.
# - Worktree: worktree-create.sh writes a real .env (the shared dev DB) for you.
# - Standalone: copy to .env and point at any Postgres that carries the kernel
#   base schema (workspaces, "user") + this plugin's schema (run migrations first).
# - CI sets these in the job environment, so .env is absent there (just docs).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ks_erp
