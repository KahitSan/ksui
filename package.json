{
  "name": "@kahitsan/kplugin_transactions",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "description": "ksERP plugin: transactions (income/expense/business entries + POS charge flow). Runs as its own process; the kserp kernel reverse-proxies to it and brokers cross-plugin RPC to packages/vouchers/clients.",
  "scripts": {
    "build:ui": "vite build -c vite.remote.config.ts",
    "changeset": "changeset",
    "dev": "tsx watch server/main.ts",
    "lint": "eslint .",
    "start": "tsx server/main.ts",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.test.json",
    "version": "changeset version"
  },
  "dependencies": {
    "@kahitsan/ksui": "^0.29.0",
    "@kahitsan/plugin-sdk": "file:../kserp/packages/plugin-sdk",
    "dotenv": "^16.5.0",
    "hono": "^4.12.0",
    "multer": "^2.1.1",
    "pg": "^8.16.0"
  },
  "peerDependencies": {
    "@ks-erp/kernel": "*"
  },
  "devDependencies": {
    "@babel/plugin-syntax-typescript": "^7.27.1",
    "@changesets/cli": "^2.27.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-sonarjs": "^4.0.3",
    "lucide-solid": "^1.7.0",
    "solid-js": "^1.9.12",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.0.0"
  }
}
