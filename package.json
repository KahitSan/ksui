{
  "name": "@kahitsan/ksui",
  "version": "0.51.0",
  "description": "Standalone SolidJS UI components with original owned icon artwork. Ships source for the consumer compiler and has no runtime dependency beyond solid-js.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./components/*": {
      "solid": "./src/components/*.tsx",
      "types": "./src/components/*.tsx",
      "development": "./src/components/*.tsx",
      "import": "./src/components/*.tsx"
    },
    "./utils/*": {
      "solid": "./src/utils/*.ts",
      "types": "./src/utils/*.ts",
      "development": "./src/utils/*.ts",
      "import": "./src/utils/*.ts"
    },
    "./tailwind": "./tailwind.js",
    "./icons": {
      "solid": "./src/icons/index.ts",
      "types": "./src/icons/index.ts",
      "import": "./src/icons/index.ts"
    },
    "./icons/registry": {
      "solid": "./src/icons/registry.ts",
      "types": "./src/icons/registry.ts",
      "import": "./src/icons/registry.ts"
    },
    "./icons/*": {
      "solid": "./src/icons/*.tsx",
      "types": "./src/icons/*.tsx",
      "import": "./src/icons/*.tsx"
    }
  },
  "files": [
    "src",
    "tailwind.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-token-fallbacks.mjs",
    "check:coverage": "node scripts/check-token-fallbacks.mjs --coverage",
    "check:palette": "node scripts/check-palette-drift.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:e2e": "vite --config e2e/vite.config.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "build:icons": "node scripts/build-icon-assets.mjs",
    "test:icon-sources": "node --test scripts/icon-source-manifest.test.mjs scripts/write-icon-modules.test.mjs scripts/trace-icon-artwork.test.mjs"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.50.0",
    "@solidjs/testing-library": "^0.8.0",
    "jsdom": "^26.0.0",
    "potrace": "^2.1.8",
    "sharp": "^0.35.5",
    "solid-js": "^1.9.0",
    "svgo": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.6",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KahitSan/ksui.git"
  },
  "license": "MIT"
}
