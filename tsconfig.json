{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@ks-erp/kernel-base": [
        "../kserp/kernel-base/index.ts"
      ],
      "@ks-erp/kernel-composite": [
        "../kserp/kernel-composite/index.ts"
      ],
      "@ks-erp/kernel-orchestrator": [
        "../kserp/kernel-orchestrator/index.ts"
      ],
      "@ks-erp/kernel-gateway": [
        "../kserp/kernel-gateway/index.ts"
      ],
      "@ks-erp/kernel-theme": [
        "../kserp/kernel-theme/index.ts"
      ]
    },
    "ignoreDeprecations": "6.0",
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": [
    "server",
    "migrations",
    "ui"
  ]
}
