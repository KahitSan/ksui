{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@kahitsan/plugin-ui": [
        "../kserp/packages/plugin-ui/src/index.ts"
      ],
      "@kahitsan/plugin-server-utils": [
        "../kserp/packages/plugin-server-utils/src/index.ts"
      ],
      "@ks-erp/kernel-base": [
        "../kserp/kernel-base/index.ts"
      ],
      "@ks-erp/kernel-composite": [
        "../kserp/kernel-composite/index.ts"
      ],
      "@ks-erp/kernel-orchestrator": [
        "../kserp/kernel-orchestrator/index.ts"
      ],
      "@ks-erp/kernel-gateway": [
        "../kserp/kernel-gateway/index.ts"
      ],
      "@ks-erp/kernel-theme": [
        "../kserp/kernel-theme/index.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "server",
    "migrations",
    "ui",
    "../kserp/sdk/host-ui.d.ts",
    "../kserp/sdk/express.d.ts"
  ]
}
