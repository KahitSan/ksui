{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": []
  },
  // The library is standalone and imports its original icon artwork locally. It
  // type-checks on its own. The authoritative gate is still each consuming
  // plugin's tsc with the consumer's Solid runtime.
  "include": ["src"]
}
